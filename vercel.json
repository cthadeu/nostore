{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "runtime": "container"
    },
    "api": {
      "root": "apps/api",
      "framework": "fastify"
    },
    "web": {
      "root": "apps/web",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "nostore-delta.vercel.app"
        }
      ],
      "destination": "https://nostore.com.br/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.nostore.com.br"
        }
      ],
      "destination": "https://nostore.com.br/$1",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/v1/internal/shipments/sync",
      "schedule": "0 9 * * *"
    }
  ]
}
