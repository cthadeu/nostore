NODE_ENV=development
PORT=3001
APP_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://nostore:nostore_local@localhost:5438/nostore
TEST_DATABASE_URL=postgresql://nostore:nostore_local@localhost:5438/nostore_test
# Generated by npm run setup. Use a unique 32-byte hex secret per environment.
ENCRYPTION_KEY=
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
MAIL_FROM=nostore <no-reply@nostore.local>

# Simulation only; production rejects this mode. No money moves.
PAYMENT_GATEWAY=simulated
# Demo deployments only: lets the simulated gateway run with NODE_ENV=production. Never with real sales.
ALLOW_SIMULATED_PAYMENTS=false
# Verified account emails allowed to edit the platform fee (comma-separated).
ADMIN_EMAILS=
# File scanning: clamav (default, requires CLAMAV_HOST) or off (uploads accepted without antivirus check).
FILE_SCAN=clamav
# npm run dev: expose a ClamAV instance locally, or run the full Compose app.
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

# Seller assets: local (files in STORAGE_DIR) or blob (Vercel Blob, private blobs).
# Defaults to blob when BLOB_STORE_ID or BLOB_READ_WRITE_TOKEN is present (Vercel injects them).
FILE_STORAGE=local
