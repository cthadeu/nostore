NODE_ENV=development
PORT=3001
APP_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://nostore:nostore_local@localhost:5438/nostore
TEST_DATABASE_URL=postgresql://nostore:nostore_local@localhost:5438/nostore_test
# Generated by npm run setup. Use a unique 32-byte hex secret per environment.
ENCRYPTION_KEY=
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
MAIL_FROM=nostore <no-reply@nostore.local>
# worker: a separate `npm run worker` process drains the e-mail queue (Compose). inline: the API drains it
# in the background after each mutating request (serverless hosts such as Vercel, no worker needed).
MAIL_DELIVERY=worker

# disabled | simulated (no money moves; production rejects it unless ALLOW_SIMULATED_PAYMENTS=true) | mercadopago
PAYMENT_GATEWAY=simulated
# Mercado Pago marketplace application (Checkout Transparente + split via OAuth). Required with PAYMENT_GATEWAY=mercadopago.
# Redirect URL to register in the application: <APP_ORIGIN>/api/v1/seller/gateway/callback
# Webhook URL (topic "Pagamentos"): <APP_ORIGIN>/api/v1/webhooks/mercadopago
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_WEBHOOK_SECRET=
# Melhor Envio application (OAuth) for calculated freight and labels on physical products. Optional: without it, shipping is manual.
# Redirect URL to register: <APP_ORIGIN>/api/v1/seller/shipping/callback. ME_ENV: sandbox | production.
ME_CLIENT_ID=
ME_CLIENT_SECRET=
ME_ENV=sandbox
# Secret Vercel sends as "Authorization: Bearer" to the daily tracking sync cron (/api/v1/internal/shipments/sync).
CRON_SECRET=
# Demo deployments only: lets the simulated gateway run with NODE_ENV=production. Never with real sales.
ALLOW_SIMULATED_PAYMENTS=false
# Verified account emails allowed to edit the platform fee (comma-separated).
ADMIN_EMAILS=
# File scanning: clamav (default, requires CLAMAV_HOST) or off (uploads accepted without antivirus check).
FILE_SCAN=clamav
# npm run dev: expose a ClamAV instance locally, or run the full Compose app.
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

# Database connections per process. Serverless keeps 2 by default (the Supabase session pooler allows 15
# clients in total); long-lived processes such as the worker or Compose can use more.
DB_POOL_MAX=

# Seller assets: local (files in STORAGE_DIR) or blob (Vercel Blob, private blobs).
# Defaults to blob when BLOB_STORE_ID or BLOB_READ_WRITE_TOKEN is present (Vercel injects them).
FILE_STORAGE=local
