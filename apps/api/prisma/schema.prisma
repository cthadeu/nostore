generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  importFileExtension = "ts"
}
datasource db {
  provider = "postgresql"
}
model User {
  id String @id @default(uuid()) @db.Uuid
  email String @unique
  name String
  passwordHash String
  emailVerifiedAt DateTime?
  termsAcceptedAt DateTime @default(now())
  createdAt DateTime @default(now())
  seller Seller?
  sessions Session[]
  tokens AuthToken[]
}
model Seller {
  id String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid
  user User @relation(fields: [userId], references: [id])
  displayName String
  personType String @default("individual")
  documentEncrypted String?
  documentLast4 String?
  plan String @default("free")
  proUntil DateTime?
  moderationStatus String @default("active")
  gatewayStatus String @default("not_connected")
  // Mercado Pago account linked by OAuth (tokens encrypted at rest).
  mpUserId String?
  mpPublicKey String?
  mpAccessTokenEncrypted String?
  mpRefreshTokenEncrypted String?
  mpTokenExpiresAt DateTime?
  mpConnectedAt DateTime?
  // Melhor Envio account linked by OAuth and the postage origin used to quote and buy labels.
  shippingStatus String @default("not_connected")
  meUserId String?
  meAccessTokenEncrypted String?
  meRefreshTokenEncrypted String?
  meTokenExpiresAt DateTime?
  meConnectedAt DateTime?
  originPhone String?
  originAddressEncrypted String?
  createdAt DateTime @default(now())
  orders Order[]
  products Product[]
  assets Asset[]
}
model Session {
  id String @id @default(uuid()) @db.Uuid
  tokenHash String @unique
  csrfHash String
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([expiresAt])
}
model AuthToken {
  id String @id @default(uuid()) @db.Uuid
  tokenHash String @unique
  kind String
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt DateTime?
  @@index([userId, kind])
}
model Product {
  id String @id @default(uuid()) @db.Uuid
  publicId String @unique @default(uuid()) @db.Uuid
  sellerId String @db.Uuid
  seller Seller @relation(fields: [sellerId], references: [id])
  name String
  description String
  priceCents Int
  type String
  status String @default("draft")
  paymentMethods String[]
  imageAssetId String? @db.Uuid
  shippingDays Int?
  // Physical products: how they ship (melhorenvio | manual) and the parcel used for quotes and labels.
  shippingMode String @default("manual")
  weightGrams Int?
  widthCm Int?
  heightCm Int?
  lengthCm Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([sellerId, createdAt])
  orders Order[]
  // Stamp buyer name and document on PDF pages at download time.
  stampBuyer Boolean @default(false)
  files ProductFile[]
  @@index([sellerId, status])
}
model Asset {
  id String @id @default(uuid()) @db.Uuid
  sellerId String @db.Uuid
  seller Seller @relation(fields: [sellerId], references: [id])
  productFiles ProductFile[]
  orderFiles OrderFile[]
  kind String
  originalName String
  storageKey String @unique
  mimeType String
  size Int
  status String
  createdAt DateTime @default(now())
  @@index([sellerId, createdAt])
}
model FeePolicy {
  id String @id @default(uuid()) @db.Uuid
  basisPoints Int
  createdBy String? @db.Uuid
  orders Order[]
  createdAt DateTime @default(now())
}
model EmailJob {
  id String @id @default(uuid()) @db.Uuid
  payloadEncrypted String
  status String @default("pending")
  attempts Int @default(0)
  availableAt DateTime @default(now())
  leaseUntil DateTime?
  sentAt DateTime?
  createdAt DateTime @default(now())
  @@index([status, availableAt])
}

model Order {
  id String @id @default(uuid()) @db.Uuid
  sellerId String @db.Uuid
  seller Seller @relation(fields: [sellerId], references: [id])
  productId String @db.Uuid
  product Product @relation(fields: [productId], references: [id])
  productName String
  productType String
  buyerName String
  buyerEmail String
  buyerDocumentEncrypted String
  addressEncrypted String?
  priceCents Int
  feeCents Int
  totalCents Int
  feeBasisPoints Int
  feePolicyId String @db.Uuid
  feePolicy FeePolicy @relation(fields: [feePolicyId], references: [id])
  status String @default("pending")
  gateway String
  checkoutKeyHash String @unique
  requestHash String
  expiresAt DateTime
  paidAt DateTime?
  downloadUntil DateTime?
  createdAt DateTime @default(now())
  payment PaymentAttempt?
  buyerSessions BuyerSession[]
  accessGrants AccessGrant[]
  downloadTickets DownloadTicket[]
  stampBuyer Boolean @default(false)
  // Freight chosen at checkout (snapshot) and the shipment that fulfils it.
  shippingCents Int @default(0)
  shippingMode String @default("manual")
  shippingServiceId Int?
  shippingServiceName String?
  shippingCarrier String?
  shippingDeliveryDays Int?
  shipment Shipment?
  files OrderFile[]
  @@index([sellerId, createdAt])
  @@index([sellerId, status])
}
model PaymentAttempt {
  id String @id @default(uuid()) @db.Uuid
  orderId String @unique @db.Uuid
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  gateway String
  reference String @unique
  method String
  status String @default("pending")
  // Provider-side data (Mercado Pago): payment id, last status detail and Pix QR code while pending.
  providerPaymentId String? @unique
  statusDetail String?
  pixQrCode String?
  pixQrCodeBase64 String?
  pixTicketUrl String?
  pixExpiresAt DateTime?
  updatedAt DateTime @updatedAt
}
// Every provider notification is stored once (idempotent on request id) and reprocessable.
model GatewayEvent {
  id String @id @default(uuid()) @db.Uuid
  provider String
  requestId String
  topic String
  action String?
  resourceId String?
  payload String
  status String @default("received")
  error String?
  createdAt DateTime @default(now())
  processedAt DateTime?
  @@unique([provider, requestId])
  @@index([provider, resourceId])
}
model AccessGrant {
  id String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  tokenHash String @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}
model DownloadTicket {
  id String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  tokenHash String @unique
  expiresAt DateTime
  usedAt DateTime?
}
model BuyerSession {
  id String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  tokenHash String @unique
  expiresAt DateTime
  @@index([expiresAt])
}
// Digital products are bundles: ordered files, snapshotted per order so later edits never change what was bought.
model ProductFile {
  productId String @db.Uuid
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  assetId String @db.Uuid
  asset Asset @relation(fields: [assetId], references: [id], onDelete: Restrict)
  position Int
  @@id([productId, assetId])
  @@index([assetId])
}
model OrderFile {
  orderId String @db.Uuid
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  assetId String @db.Uuid
  asset Asset @relation(fields: [assetId], references: [id], onDelete: Restrict)
  position Int
  @@id([orderId, assetId])
  @@index([assetId])
}
// Fulfilment of a physical order: a Melhor Envio label bought by the platform with the seller's
// wallet (pending → purchased → generated → posted → delivered) or a manual posting with tracking.
model Shipment {
  id String @id @default(uuid()) @db.Uuid
  orderId String @unique @db.Uuid
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  mode String
  status String @default("pending")
  meOrderId String? @unique
  meProtocol String?
  carrier String?
  service String?
  trackingCode String?
  labelUrl String?
  priceCents Int?
  error String?
  postedAt DateTime?
  deliveredAt DateTime?
  lastSyncAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, lastSyncAt])
}
