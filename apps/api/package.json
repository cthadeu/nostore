{
  "name": "@nostore/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=../../.env --watch src/server.ts",
    "start": "node src/server.ts",
    "worker": "node --env-file-if-exists=../../.env src/worker.ts",
    "build": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "node --env-file-if-exists=../../.env ../../node_modules/prisma/build/index.js migrate deploy",
    "typecheck": "tsc --noEmit",
    "test": "node --env-file-if-exists=../../.env --test --test-concurrency=1 test/*.test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^9.2.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.5.1",
    "@fastify/type-provider-typebox": "^5.2.0",
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "@sinclair/typebox": "^0.34.41",
    "@vercel/blob": "^2.8.1",
    "argon2": "^0.44.0",
    "fastify": "^5.6.0",
    "fastify-plugin": "^5.1.0",
    "nodemailer": "^7.0.10",
    "pdf-lib": "^1.17.1",
    "pg": "^8.16.3",
    "sharp": "^0.34.4",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@types/nodemailer": "^7.0.3",
    "@types/pg": "^8.15.6",
    "@types/yazl": "^3.3.1",
    "prisma": "^7.0.0"
  }
}
